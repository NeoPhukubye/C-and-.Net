@* Make the root namespace available to every view. *@
@using React
@* Import the Kendo UI tag helpers used in the views. *@
@using Kendo.Mvc.UI
@* Enable the built-in ASP.NET Core tag helpers such as asp-for and asp-action. *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* Enable the Kendo UI tag helpers such as kendo-grid and kendo-datetimepicker. *@
@addTagHelper *, Kendo.Mvc
