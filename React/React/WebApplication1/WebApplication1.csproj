<!-- Web SDK for an ASP.NET Core project with controllers and OpenAPI. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Target the current .NET runtime used by the rest of the solution. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Enable nullable reference warnings for safer C# code. -->
    <Nullable>enable</Nullable>
    <!-- Import common namespaces so using statements stay short. -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built-in OpenAPI document generation for the development Swagger endpoint. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Entity Framework Core runtime used by DonationDBContext. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <!-- SQL Server provider for the DevConnection connection string. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <!-- Design-time tools for creating migrations; excluded from published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Design-time services needed by the "dotnet ef" command line. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Optional scaffolding tool used to generate controllers and views. -->
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.3" />
  </ItemGroup>

</Project>
