# Base address of the WebApplication1 development server.
@WebApplication1_HostAddress = http://localhost:5159

# List every candidate, sorted by name by the API.
GET {{WebApplication1_HostAddress}}/api/DCandidate
Accept: application/json

# Read a single candidate by id.
GET {{WebApplication1_HostAddress}}/api/DCandidate/1
Accept: application/json

# Create a candidate; the API validates every field before saving.
POST {{WebApplication1_HostAddress}}/api/DCandidate
Content-Type: application/json

{
  "fullName": "Jane Doe",
  "email": "jane.doe@example.com",
  "age": 28,
  "bloodGroup": "O+",
  "mobile": "0821234567",
  "address": "12 Long Street, Cape Town"
}

# Update the candidate with id 1; the route id wins over the body id.
PUT {{WebApplication1_HostAddress}}/api/DCandidate/1
Content-Type: application/json

{
  "fullName": "Jane Doe",
  "email": "jane.doe@example.com",
  "age": 29,
  "bloodGroup": "O+",
  "mobile": "0821234567",
  "address": "12 Long Street, Cape Town"
}

# Delete the candidate with id 1.
DELETE {{WebApplication1_HostAddress}}/api/DCandidate/1
